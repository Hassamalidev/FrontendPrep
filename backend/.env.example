# Copy to .env for local development. Only DATABASE_URL and JWT_SECRET are
# required in production -- everything else has a working default.

# --- Identity ---------------------------------------------------------------
APP_NAME="Frontline Prep API"
ENV=local                      # local | staging | production
DEBUG=true
API_PREFIX=/api/v1

# --- Database ---------------------------------------------------------------
# Paste the Neon connection string as-is; it is normalised to asyncpg and the
# libpq-only query args (sslmode, channel_binding) are stripped automatically.
DATABASE_URL=postgresql://issb:issb@localhost:5432/issb
# Use Neon's POOLED endpoint (-pooler host) for the API. It sits behind
# pgbouncer, which is why statement caching must stay off:
DB_STATEMENT_CACHE_SIZE=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE=280
DB_ECHO=false

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8

# Created by `python -m app.seed` if the account does not exist.
# Change the password immediately after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@frontlineprep.pk
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_NAME=Super Admin

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Question engine (no API key: it runs locally) --------------------------
AGENT_USE_NLP=true             # try spaCy; silently falls back to rules
AGENT_MAX_QUESTIONS=40
AGENT_MIN_QUALITY=0.55         # critic score below this is discarded
AGENT_MIN_ARTICLE_CHARS=320

# --- Answer-sheet upload ----------------------------------------------------
# Uploaded sheets are read in memory and never stored, so this caps request
# memory rather than disk. OCR is optional; without it the candidate types
# their transcription instead.
OCR_ENABLED=true
UPLOAD_MAX_BYTES=8388608
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic

# --- Retention (keeps the database inside Neon's free 0.5 GB) --------------
RETAIN_AGENT_RUNS=200
RETAIN_ARTICLE_BODY_DAYS=45
RETAIN_ATTEMPT_DETAIL_DAYS=180
MAX_UPLOAD_CHARS=200000

# --- Password hashing -------------------------------------------------------
# Argon2id work factor. Raise if your host has memory to spare; the defaults fit
# a 512 MB instance. The test suite overrides these to keep the suite fast.
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
