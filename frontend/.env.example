# The deployed API, including the /api/v1 prefix.
#
# Leave unset for local development: the Vite dev server proxies /api to
# http://127.0.0.1:8000, so the browser never sees CORS.
#
# On Vercel this MUST be set, because the API lives on a different origin:
#   VITE_API_URL=https://frontline-prep-api.onrender.com/api/v1
#
# Vite inlines VITE_* variables at BUILD time, not run time -- changing this in
# the Vercel dashboard requires a redeploy to take effect.
VITE_API_URL=/api/v1
